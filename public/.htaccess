<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Old password link -> home
  RewriteRule ^resume-access/?$ / [R=301,L]

  # React Router fallback
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>